{
  "proyecto": "IA2 Entrega 2 — PlantVillage semi-supervisado",
  "dataset": "mohanty/PlantVillage",
  "configuracion_dataset": "color RGB",
  "fuente_splits": "splits/color_train.txt y splits/color_test.txt",
  "seed": 42,
  "clases": [
    "Tomato___healthy",
    "Tomato___Bacterial_spot",
    "Tomato___Early_blight",
    "Tomato___Late_blight",
    "Tomato___Tomato_mosaic_virus"
  ],
  "imagenes_train_oficial_por_clase": 160,
  "imagenes_test_oficial_por_clase": 40,
  "fraccion_val": 0.2,
  "fraccion_etiquetas_objetivo": 0.25,
  "fraccion_etiquetas_observada": 0.25,
  "n_train": 640,
  "n_val": 160,
  "n_test": 200,
  "n_etiquetado": 160,
  "n_no_etiquetado": 480,
  "arquitectura": "ResNet18 ImageNet, train layer4 + fc",
  "imagen_size": 224,
  "batch_size": 32,
  "epochs_maximas": 12,
  "warmup_epochs": 3,
  "patience": 5,
  "lr_fc": 0.001,
  "lr_layer4": 0.0001,
  "weight_decay": 0.0001,
  "umbral_pseudoetiqueta": 0.85,
  "lambda_u": 0.5,
  "hardware": "cuda",
  "version_python": "3.13.16",
  "version_torch": "2.14.1+cu130",
  "version_torchvision": "0.29.1+cu130",
  "version_numpy": "2.4.6",
  "version_pandas": "2.2.3",
  "nota": "Subconjunto balanceado. Resultados test calculados una sola vez al final."
}